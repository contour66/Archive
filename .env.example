# Contentstack Configuration
# Copy this file to .env.local and fill in your actual values

CONTENTSTACK_API_HOST="https://api.contentstack.io/"
CONTENTSTACK_CDN="https://cdn.contentstack.io/"
CONTENTSTACK_API_KEY="your_api_key_here"
CONTENTSTACK_DELIVERY_TOKEN="your_delivery_token_here"
CONTENTSTACK_ENVIRONMENT="preview"
CONTENTSTACK_PREVIEW_HOST="rest-preview.contentstack.com"

# CRITICAL: This must be set to 'true' for live preview to work
isLivePreviewEnabled=true

# Client-side variables (exposed to browser)
NEXT_PUBLIC_CONTENTSTACK_LIVE_PREVIEW=true
NEXT_PUBLIC_CONTENTSTACK_API_KEY="your_api_key_here"
NEXT_PUBLIC_CONTENTSTACK_ENVIRONMENT="preview"
